# Development defaults. In production use your hosting provider's secret store.
VOXSHIELD_ENV=development
VOXSHIELD_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
VOXSHIELD_MAX_UPLOAD_BYTES=10485760
VOXSHIELD_RATE_LIMIT_PER_MINUTE=30
VOXSHIELD_VOICEPRINT_RETENTION_DAYS=30
# Required to enable the moderator-only confirmation endpoint. Keep this secret.
VOXSHIELD_ADMIN_TOKEN=replace-with-a-long-random-secret
# Keep false unless users have been told persona text is sent to an external TTS provider.
VOXSHIELD_ENABLE_CLOUD_TTS=false
VOXSHIELD_TTS_TIMEOUT_SECONDS=12
